    "h": 8

  },

  "datasource": {

    "type": "loki",

    "uid": "${DS_LOKI}"

  },

  "targets": [

    {

      "refId": "A",

      "expr": "max_over_time({sd1c_component=\"PRISM_SFT\",component=\"activepivot\",source=\"activepivot-main\",hostname=~\"$hostname\"} |= \"event_type=JvmMemoryReport\" | regexp \"G1 Old Generation\\\\[count=[0-9]+.*?time=(?P<old_gc_time>[0-9]+)s\" | unwrap old_gc_time [30s])",

      "legendFormat": "G1 Old GC Time"

    }

  ]

},

{

  "title": "JVM Memory Dashboard",

  "schemaVersion": 39,

  "version": 1,

  "time": {

    "from": "now-3h",

    "to": "now"

  },

  "templating": {

    "list": [

      {

        "name": "hostname",

        "type": "query",

        "datasource": {

          "type": "loki",

          "uid": "${DS_LOKI}"

        },

        "query": "label_values(hostname)",

        "includeAll": true,

        "multi": true,

        "refresh": 1

      }

    ]

  }

}
